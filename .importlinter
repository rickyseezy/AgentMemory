[importlinter]
root_packages =
    agentmemory
include_external_packages = True

[importlinter:contract:operations layers]
name = Operations clean architecture layers
type = layers
layers =
    agentmemory.operations.infrastructure
    agentmemory.operations.adapters
    agentmemory.operations.application
    agentmemory.operations.domain

[importlinter:contract:domain independence]
name = Domain is independent of frameworks and adapters
type = forbidden
source_modules =
    agentmemory.operations.domain
forbidden_modules =
    fastapi
    pydantic
    sqlalchemy
    neo4j
    httpx
    agentmemory.operations.application
    agentmemory.operations.adapters
    agentmemory.operations.infrastructure

[importlinter:contract:application independence]
name = Application is independent of frameworks and infrastructure
type = forbidden
source_modules =
    agentmemory.operations.application
forbidden_modules =
    fastapi
    pydantic
    sqlalchemy
    neo4j
    httpx
    agentmemory.operations.adapters
    agentmemory.operations.infrastructure

[importlinter:contract:provider layers]
name = Provider clean architecture layers
type = layers
layers =
    agentmemory.providers.infrastructure
    agentmemory.providers.adapters
    agentmemory.providers.application
    agentmemory.providers.domain

[importlinter:contract:provider domain independence]
name = Provider domain is framework independent
type = forbidden
source_modules =
    agentmemory.providers.domain
forbidden_modules =
    fastapi
    httpx
    pydantic
    pydantic_settings
    uvicorn
    agentmemory.providers.application
    agentmemory.providers.adapters
    agentmemory.providers.infrastructure

[importlinter:contract:identity layers]
name = Identity clean architecture layers
type = layers
layers =
    agentmemory.identity.infrastructure
    agentmemory.identity.adapters
    agentmemory.identity.application
    agentmemory.identity.domain

[importlinter:contract:identity domain independence]
name = Identity domain is framework and context independent
type = forbidden
source_modules =
    agentmemory.identity.domain
forbidden_modules =
    fastapi
    httpx
    neo4j
    pydantic
    pydantic_settings
    sqlalchemy
    uvicorn
    agentmemory.identity.application
    agentmemory.identity.adapters
    agentmemory.identity.infrastructure
    agentmemory.operations
    agentmemory.providers

[importlinter:contract:identity application independence]
name = Identity application is framework and context independent
type = forbidden
source_modules =
    agentmemory.identity.application
forbidden_modules =
    fastapi
    httpx
    neo4j
    pydantic
    pydantic_settings
    sqlalchemy
    uvicorn
    agentmemory.identity.adapters
    agentmemory.identity.infrastructure
    agentmemory.operations
    agentmemory.providers
