{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmemory.dev/contracts/pf001-support-matrix/v1.json",
  "title": "AgentMemory PF-001 native support matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "matrix_id",
    "story",
    "owner",
    "procedure_version",
    "maximum_evidence_age_seconds",
    "agent_hosts",
    "cells",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "matrix_id": {
      "$ref": "#/$defs/id"
    },
    "story": {
      "const": "PF-001"
    },
    "owner": {
      "$ref": "#/$defs/id"
    },
    "procedure_version": {
      "$ref": "#/$defs/id"
    },
    "maximum_evidence_age_seconds": {
      "type": "integer",
      "minimum": 3600,
      "maximum": 2592000
    },
    "agent_hosts": {
      "type": "array",
      "prefixItems": [
        { "const": "claude" },
        { "const": "codex" },
        { "const": "cursor" },
        { "const": "gemini" },
        { "const": "generic-custom" }
      ],
      "items": false,
      "minItems": 5,
      "maxItems": 5
    },
    "cells": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cell"
      },
      "minItems": 7,
      "maxItems": 7
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenario"
      },
      "minItems": 13,
      "maxItems": 13
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]{1,5}(\\.[0-9]{1,5}){1,3}$"
    },
    "idArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true,
      "maxItems": 128
    },
    "stockImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "source",
        "reset_method",
        "identity_kind"
      ],
      "properties": {
        "authority": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "reset_method": {
          "$ref": "#/$defs/id"
        },
        "identity_kind": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "status",
        "operating_system",
        "architecture",
        "distribution",
        "minimum_os_version",
        "maximum_os_version",
        "minimum_build",
        "maximum_build",
        "filesystem",
        "stock_image",
        "runner_labels",
        "runtime_states",
        "privilege_expectations",
        "reboot_expectation",
        "vendor_channel",
        "offline_redistribution_policy",
        "fixture_suites"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "owner": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "const": "required"
        },
        "operating_system": {
          "enum": [
            "darwin",
            "linux",
            "windows"
          ]
        },
        "architecture": {
          "enum": [
            "amd64",
            "arm64"
          ]
        },
        "distribution": {
          "enum": [
            "fedora-44",
            "macos-tahoe",
            "ubuntu-24.04",
            "windows-11-25h2"
          ]
        },
        "minimum_os_version": {
          "$ref": "#/$defs/version"
        },
        "maximum_os_version": {
          "$ref": "#/$defs/version"
        },
        "minimum_build": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_build": {
          "type": "integer",
          "minimum": 1
        },
        "filesystem": {
          "enum": [
            "apfs",
            "ext4",
            "ntfs",
            "xfs"
          ]
        },
        "stock_image": {
          "$ref": "#/$defs/stockImage"
        },
        "runner_labels": {
          "$ref": "#/$defs/idArray"
        },
        "runtime_states": {
          "type": "array",
          "prefixItems": [
            { "const": "absent" },
            { "const": "compatible-running" },
            { "const": "compatible-stopped" }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "privilege_expectations": {
          "$ref": "#/$defs/idArray"
        },
        "reboot_expectation": {
          "enum": [
            "optional",
            "required-when-prerequisite-changes"
          ]
        },
        "vendor_channel": {
          "const": "stable"
        },
        "offline_redistribution_policy": {
          "enum": [
            "redistributable",
            "user-supplied-official"
          ]
        },
        "fixture_suites": {
          "$ref": "#/$defs/idArray"
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "platforms",
        "distributions",
        "variants",
        "evidence_kinds"
      ],
      "properties": {
        "id": {
          "enum": [
            "agent-host-integration",
            "fail-closed-host-conditions",
            "install-lifecycle",
            "interruption-recovery",
            "linux-apt-native",
            "linux-dnf-native",
            "local-semantic-no-egress",
            "macos-native-security",
            "network-adversarial",
            "upgrade-removal",
            "usability-accessibility",
            "windows-native-security",
            "windows-wsl-prerequisites"
          ]
        },
        "platforms": {
          "type": "array",
          "items": {
            "enum": [
              "darwin",
              "linux",
              "windows"
            ]
          },
          "uniqueItems": true,
          "maxItems": 3
        },
        "distributions": {
          "type": "array",
          "items": {
            "enum": [
              "fedora-44",
              "macos-tahoe",
              "ubuntu-24.04",
              "windows-11-25h2"
            ]
          },
          "uniqueItems": true,
          "maxItems": 4
        },
        "variants": {
          "$ref": "#/$defs/idArray"
        },
        "evidence_kinds": {
          "type": "array",
          "items": {
            "enum": [
              "accessibility-report",
              "egress-report",
              "host-attestation",
              "journal",
              "packet-capture",
              "recovery-trace",
              "result",
              "security-report",
              "study-record",
              "transcript"
            ]
          },
          "uniqueItems": true,
          "minItems": 4,
          "maxItems": 10
        }
      }
    }
  }
}
